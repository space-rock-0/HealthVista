# Copy to apps/client/.env.
# VITE_* values are public and included in the browser bundle.
# Keep secret API keys, JWT secrets, and database credentials in apps/server/.env.

# Local backend API and Socket.io origins. Use public API URLs when deploying.
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Optional Stripe publishable key for card payments (pk_test_... locally).
# Must match the Stripe account/mode of STRIPE_SECRET_KEY in apps/server/.env.
# Leave empty if online card payments are not configured.
VITE_STRIPE_PUBLISHABLE_KEY=
