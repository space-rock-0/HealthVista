{
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://healthvista-api.onrender.com/api/:path*" },
    {
      "source": "/socket.io/:path*",
      "destination": "https://healthvista-api.onrender.com/socket.io/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
