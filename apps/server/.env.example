# Copy to apps/server/.env. Keep real credentials private.
# Basic local use requires PostgreSQL URLs and two generated JWT secrets.
# Leave optional service credentials empty to skip those integrations.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Additional allowed frontend origins, comma-separated.
CORS_ORIGINS=

# PostgreSQL with pgvector. Defaults match docker-compose.yml.
# For hosted PostgreSQL: pooled URL for DATABASE_URL, direct URL for DIRECT_URL.
DATABASE_URL=postgresql://medicore:medicore@localhost:5432/medicore?schema=public
DIRECT_URL=postgresql://medicore:medicore@localhost:5432/medicore?schema=public

# Optional Redis for caching and background jobs, including reminders.
# Defaults match docker-compose.yml. Set REDIS_ENABLED=false if unavailable.
# Hosted Redis requires a Redis connection URL, not a REST API token.
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# REQUIRED: two DIFFERENT random secrets, at least 32 characters each.
# Run this command twice; paste one output into each variable:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LOGIN_RATE_LIMIT_MAX=5

# Optional Google OAuth: patient sign-in with Google.
# Use a Web application OAuth client ID and secret from Google Cloud Console.
# Local authorized JavaScript origin: http://localhost:5173
# Local authorized redirect URI: http://localhost:5000/api/auth/google/callback
# In production use your public API origin with the same callback path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Optional Cloudinary: medical-record file uploads. Set all three account values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Jina AI: AI generation/chat, embeddings, and semantic retrieval.
# Set your Jina API key. Models below are the application's defaults.
# Embeddings use api.jina.ai; jina-vlm chat uses api-beta-vlm.jina.ai.
# Run npm run db:embed after configuring the database and key for existing records.
JINA_API_KEY=
JINA_CHAT_MODEL=jina-vlm
JINA_EMBED_MODEL=jina-embeddings-v5-text-small

# Optional Stripe: online card payments. Use test-mode keys locally.
# Server secret key: sk_test_...; webhook signing secret: whsec_...
# Webhook path: /api/payments/webhook/stripe
# Events: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded.
# Also set VITE_STRIPE_PUBLISHABLE_KEY in apps/client/.env (pk_test_...).
# Server/client keys must use the same Stripe account and mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Twilio: SMS notifications. Set all three account/sender values.
# Phone number includes country code, for example +15551234567.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
